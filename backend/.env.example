# DynamicRadar backend configuration
# Copy to `.env` and adjust as needed.

# --- Server ---
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed CORS origins (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- NEXRAD Level II (public NOAA S3 bucket; no credentials required) ---
NEXRAD_BUCKET=noaa-nexrad-level2
NEXRAD_REGION=us-east-1

# --- NWS API (warnings / alerts) ---
# NWS requires a descriptive User-Agent identifying the application + contact.
NWS_API_BASE=https://api.weather.gov
NWS_USER_AGENT=DynamicRadar (contact@example.com)

# --- Runtime cache for downloaded volume scans ---
CACHE_DIR=app/data/cache
