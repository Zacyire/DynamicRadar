# DynamicRadar backend configuration
# Copy to `.env` and adjust as needed.

# --- Server ---
HOST=0.0.0.0
# PORT is read from the environment. Locally defaults to 8000; on Render/Heroku
# the platform injects $PORT and the start command binds to it — do not hardcode.
PORT=8000
# Comma-separated list of allowed CORS origins. In production set this to your
# deployed frontend URL, e.g. https://dynamicradar.vercel.app
# A single "*" allows any origin (credentials auto-disabled) for quick testing.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- NEXRAD Level II (public S3 bucket; anonymous/unsigned, no credentials) ---
# Default is Unidata's mirror (same YYYY/MM/DD/ICAO/ layout as NOAA).
# Canonical NOAA bucket: noaa-nexrad-level2 (use if reachable from your network).
NEXRAD_BUCKET=unidata-nexrad-level2
NEXRAD_REGION=us-east-1

# --- NWS API (warnings / alerts) ---
# NWS requires a descriptive User-Agent identifying the application + contact.
NWS_API_BASE=https://api.weather.gov
NWS_USER_AGENT=DynamicRadar (contact@example.com)

# --- Runtime cache for downloaded volume scans ---
CACHE_DIR=app/data/cache
