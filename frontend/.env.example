# DynamicRadar frontend configuration (Vite — only VITE_* vars are exposed)
# Copy to `.env` and fill in.

# Mapbox GL JS access token (required for the 2D map).
# Get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Backend API base.
#   - Local dev: leave EMPTY to use the Vite proxy ("/api" → localhost:8000).
#   - Production: set to your hosted backend origin (NO trailing slash), e.g.
#     VITE_API_BASE=https://dynamicradar-api.onrender.com
# NOTE: Vite bakes this in at BUILD time — rebuild (`npm run build`) after changing.
VITE_API_BASE=
