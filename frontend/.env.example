# DynamicRadar frontend configuration (Vite — only VITE_* vars are exposed)
# Copy to `.env` and fill in.

# Mapbox GL JS access token (required for the 2D map).
# Get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Backend API base. Leave empty in dev to use the Vite proxy ("/api").
VITE_API_BASE=
